airflow:
  connections:
    - conn_id: snowflake_conn
      conn_type: snowflake
      conn_host:
      conn_schema: your_schema_here
      conn_login: your_snowflake_username
      conn_password:
      conn_port:
      conn_extra:
        account: your_account_identifier
        database: your_database_here
        warehouse: your_warehouse_here
        role: your_role_here
        private_key_content: |
          -----BEGIN PRIVATE KEY-----
          paste the contents of your rsa_key.p8 here
          -----END PRIVATE KEY-----
  pools:
    - pool_name:
      pool_slot:
      pool_description:
  variables:
    - variable_name:
      variable_value:
